(
    schema: "xindeler_open_world.settlement_template_contract.v1",
    coordinate_space: "normalized_map_xy_top_left_origin",
    notes: [
        "Source contract only. It does not move site pins or generate terrain.",
        "The future exporter resolves a template from category, size, population tag, and optional site override.",
        "xindeler-old fallback names document the current test representation; they are not the final architecture.",
        "target_buildings is the default building-count target of a family (the type x size matrix of NH-167, section 9.5 of the settlement-footprint design). A settlement may override it in authored_settlement_profiles.ron; the exporter resolves one number per settlement into cromatolis_v0_sites.ron.",
        "building_programme (inn, post) lists the buildings of a fixed-programme family; its counts must add up to target_buildings.",
        "Family ids keep the technical category names: hamlet is the Caserio type (displayed as Caserio), aldea is the indigenous-style village, village is the Villa.",
    ],
    template_families: [
        (
            id: "capital_royal",
            category: "capital",
            supported_sizes: ["very_large"],
            target_buildings: 650,
            xindeler_old_fallback: "refactor_city_with_castle",
            terrain_requirement: "broad_flat_core",
            terrain_adaptation: "edge_terraces_only",
            districts: ["royal_castle", "civic", "market", "military", "craft", "residential", "gates"],
        ),
        (
            id: "city_very_large",
            category: "city",
            supported_sizes: ["very_large"],
            target_buildings: 650,
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "flat_or_gentle_core",
            terrain_adaptation: "district_terraces_allowed",
            districts: ["civic", "market", "military", "craft", "residential", "gates"],
        ),
        (
