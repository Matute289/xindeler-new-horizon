        (id: "dark_mix", applies_to_population_tag: "dark_mix", architectural_direction: "dark_plural_settlement"),
        (id: "custom", applies_to_population_tag: "custom", architectural_direction: "resolve_from_site_population"),
    ],
    site_overrides: [
        (site_id: "site.kalthis", template_id: "capital_royal", special_core: "royal_castle", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.duren", template_id: "city_large", special_core: "royal_memorial_cemetery", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.tenoxitlan", template_id: "hamlet_large", terrain_recheck_after: "heightmap_manual_v4"),
