    culture_overlays: [
        (id: "human", applies_to_population_tag: "human", architectural_direction: "human_settlement"),
        (id: "elven", applies_to_population_tag: "elven", architectural_direction: "elven_settlement"),
        (id: "humanoid_mix", applies_to_population_tag: "humanoid_mix", architectural_direction: "shared_humanoid_settlement"),
