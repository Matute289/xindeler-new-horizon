        (site_id: "site.the_sapphire_pillow", template_id: "inn_roadside", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.the_fish_journey", template_id: "inn_roadside", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.le_pont_dargent", template_id: "inn_roadside", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.trident_dreams", template_id: "inn_roadside", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.twin_dreams", template_id: "inn_roadside", terrain_recheck_after: "l16_master"),
        (site_id: "site.under_the_river", template_id: "inn_roadside", terrain_recheck_after: "l16_master"),
        (site_id: "site.el_ojo_de_luna", template_id: "inn_roadside", terrain_recheck_after: "l16_master"),
    ],
