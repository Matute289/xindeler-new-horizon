            target_buildings: 6,
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "small_gentle_core",
            terrain_adaptation: "minimal_terraces",
            districts: ["common"],
        ),
        (
            id: "aldea_large",
            category: "aldea",
            supported_sizes: ["large"],
            target_buildings: 25,
            // Indigenous-style village. The engine uses the Villa house style as a placeholder until
            // dedicated assets exist (NH-167 T41).
            architectural_direction: "indigenous_aldea",
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "gentle_core",
            terrain_adaptation: "limited_terraces",
            districts: ["common", "small_trade", "craft"],
        ),
        (
            id: "aldea_medium",
            category: "aldea",
            supported_sizes: ["medium"],
            target_buildings: 18,
            // Indigenous-style village. The engine uses the Villa house style as a placeholder until
            // dedicated assets exist (NH-167 T41).
            architectural_direction: "indigenous_aldea",
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "small_gentle_core",
            terrain_adaptation: "minimal_terraces",
            districts: ["common", "small_trade"],
        ),
        (
            id: "aldea_small",
            category: "aldea",
            supported_sizes: ["small"],
            target_buildings: 12,
            // Indigenous-style village. The engine uses the Villa house style as a placeholder until
            // dedicated assets exist (NH-167 T41).
            architectural_direction: "indigenous_aldea",
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "small_gentle_core",
            terrain_adaptation: "minimal_terraces",
            districts: ["common"],
        ),
        (
            id: "inn_roadside",
            category: "inn",
            supported_sizes: ["minimal", "small"],
            target_buildings: 2,
            xindeler_old_fallback: "camp",
            terrain_requirement: "small_flat_pad",
            terrain_adaptation: "no_terrace_required",
            districts: ["tavern", "guest_rooms", "stables"],
            intended_building: "three_or_four_storey_roadside_inn",
            // Building programme (NH-167 T42): the counts add up to target_buildings. Authored here as data;
            // today the engine still generates one special plot per inn.
            building_programme: [
                (building: "inn", count: 1, note: "bar and restaurant on the ground floor, one or more floors of guest rooms above"),
                (building: "stable", count: 1, note: "horses and mounts"),
            ],
        ),
        (
            id: "post_military",
            category: "post",
            supported_sizes: ["minimal", "small"],
            target_buildings: 3,
            xindeler_old_fallback: "camp",
            terrain_requirement: "small_flat_pad_or_ridge",
            terrain_adaptation: "minimal_terraces",
            districts: ["watch", "barracks", "supply"],
            // Building programme (NH-167 T42): the counts add up to target_buildings. Authored here as data;
            // today the engine still generates one special plot per post.
            building_programme: [
                (building: "post", count: 1, note: "the military post itself, laid out on a small footprint beside the road"),
                (building: "barracks", count: 1, storeys: 2, note: "two-storey mini barracks where the soldiers sleep"),
                (building: "stable", count: 1, note: "horses and mounts"),
            ],
        ),
    ],
    culture_overlays: [
        (id: "human", applies_to_population_tag: "human", architectural_direction: "human_settlement"),
        (id: "elven", applies_to_population_tag: "elven", architectural_direction: "elven_settlement"),
        (id: "humanoid_mix", applies_to_population_tag: "humanoid_mix", architectural_direction: "shared_humanoid_settlement"),
        (id: "super_mix", applies_to_population_tag: "super_mix", architectural_direction: "plural_settlement"),
        (id: "dark_mix", applies_to_population_tag: "dark_mix", architectural_direction: "dark_plural_settlement"),
        (id: "custom", applies_to_population_tag: "custom", architectural_direction: "resolve_from_site_population"),
    ],
    site_overrides: [
        (site_id: "site.kalthis", template_id: "capital_royal", special_core: "royal_castle", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.duren", template_id: "city_very_large", special_core: "royal_memorial_cemetery", terrain_recheck_after: "heightmap_manual_v3"),
        (site_id: "site.tenoxitlan", template_id: "aldea_large", terrain_recheck_after: "heightmap_manual_v4"),
