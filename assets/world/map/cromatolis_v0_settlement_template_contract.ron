(
    schema: "xindeler_open_world.settlement_template_contract.v1",
    coordinate_space: "normalized_map_xy_top_left_origin",
    notes: [
        "Source contract only. It does not move site pins or generate terrain.",
        "The future exporter resolves a template from category, size, population tag, and optional site override.",
        "xindeler-old fallback names document the current test representation; they are not the final architecture.",
    ],
    template_families: [
