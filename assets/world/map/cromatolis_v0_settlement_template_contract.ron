            supported_sizes: ["small"],
            target_buildings: 60,
            xindeler_old_fallback: "refactor_city",
            terrain_requirement: "gentle_core",
            terrain_adaptation: "limited_terraces",
            districts: ["residential", "local_trade"],
        ),
        (
