(
    schema: "xindeler_open_world.ground_cover_profile.v1",
    // `ground_cover` is authored luminance: blackness percentage is
    // `(1 - luminance) * 100`. It only controls visible soil and never tree
    // density or placement.
    bands: [
        // Map tints are deliberately more restrained than the in-world
        // surface tints: they retain the terrain's own soil, hillshade,
        // contours and altitude texture instead of washing every unzoned
        // lowland into the same green.  Regional ecology is applied later by
        // `cromatolis_v0_map_ecology.ron` where a categorical zone exists.
        // BareDry means scant vegetation, not sand. Sand is categorical and
        // comes only from `ground_substrate_zones.ron` at Northwall.
        (band: BareDry, max_cover: 0.10, surface_tint: (0.25, 0.48, 0.16), surface_blend: 0.55, map_tint: (0.34, 0.37, 0.17), map_blend: 0.24),
        (band: Grassland, max_cover: 0.25, surface_tint: (0.32, 0.50, 0.17), surface_blend: 0.42, map_tint: (0.38, 0.46, 0.20), map_blend: 0.24),
        (band: SparseWoodland, max_cover: 0.35, surface_tint: (0.20, 0.40, 0.15), surface_blend: 0.54, map_tint: (0.22, 0.36, 0.16), map_blend: 0.25),
        (band: Forest, max_cover: 0.55, surface_tint: (0.13, 0.32, 0.11), surface_blend: 0.66, map_tint: (0.06, 0.32, 0.09), map_blend: 0.26),
        (band: Jungle, max_cover: 1.0, surface_tint: (0.06, 0.27, 0.12), surface_blend: 0.76, map_tint: (0.04, 0.22, 0.09), map_blend: 0.28),
    ],
)
