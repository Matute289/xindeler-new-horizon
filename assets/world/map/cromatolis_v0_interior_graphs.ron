                (id: "level.kharvun_basal_ruins", canon_label: "Basal Ruins", domain: "kharvun_reach", floor_z_m: -1320, ceiling_z_m: -1201, medium: "air", generation: "authored_core_procedural_dressing", notes: "Dry, layered ruins with several unrelated architectural families."),
