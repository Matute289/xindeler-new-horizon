ItemDef(
    legacy_name: "Naturalist Walking Stick",
    legacy_description: "Heals your allies with the power of nature.",
    kind: Tool((
        kind: Sceptre,
        hands: Two,
        role: Some(Caster),
        stats: (
            equip_time_secs: 0.4,
            power: 0.45,
            effect_power: 0.1,
            speed: 0.95,
            range: 0.95,
            energy_efficiency: 1.0,
            buff_strength: 0.9,
        ),
    )),
    quality: Low,
    tags: [],
    ability_spec: None,
    // Sceptre: the class whitelist below is the ONLY thing restricting who
    // may wield it. Every legacy sceptre ability (healingaura, wardingaura,
    // lifestealbeam) has no per-spell class filter of its own, so this is
    // what stops e.g. a Warrior from casting healingaura with a picked-up
    // sceptre.
    requirements: Some((
        classes: Some([Cleric, Druid]),
        min_level: None,
        races: None,
    )),
)