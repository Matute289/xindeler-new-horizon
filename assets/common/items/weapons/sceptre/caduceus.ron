ItemDef(
    legacy_name: "Caduceus",
    legacy_description: "The snakes seem to be alive",
    kind: Tool((
        kind: Sceptre,
        hands: Two,
        role: Some(Caster),
        stats: (
            equip_time_secs: 0.4,
            power: 2.25,
            effect_power: 1.0,
            speed: 0.6,
            range: 1.0,
            energy_efficiency: 1.0,
            buff_strength: 1.0,
        ),
    )),
    quality: Legendary,
    tags: [],
    ability_spec: None,
    // Sceptre: the class whitelist below is the ONLY thing restricting who
    // may wield it. Every legacy sceptre ability (healingaura, wardingaura,
    // lifestealbeam) has no per-spell class filter of its own, so this is
    // what stops e.g. a Warrior from casting healingaura with a picked-up
    // sceptre.
    requirements: Some((
        classes: Some([Cleric, Druid]),
        min_level: None,
        races: None,
    )),
)