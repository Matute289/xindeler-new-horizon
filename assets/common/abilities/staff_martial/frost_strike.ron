// The martial staff's on-hit elemental proc (baked directly into the strike,
// not a passive self-buff): a heavier single bash that has a chance to
// inflict the existing `Frozen` debuff, reusing the shared buff kind rather
// than introducing a new mechanic.
BasicMelee(
    energy_cost: 15,
    buildup_duration: 0.5,
    swing_duration: 0.15,
    hit_timing: 0.6,
    recover_duration: 0.4,
    melee_constructor: (
        kind: Bash(
            damage: 26,
            poise: 30,
            knockback: 8,
            energy_regen: 0,
        ),
        range: 3.5,
        angle: 25.0,
        damage_effect: Some(Buff((
            kind: Frozen,
            dur_secs: 4.0,
            strength: Value(0.4),
            chance: 0.25,
        ))),
    ),
    ori_modifier: (
        buildup: Some(0.6),
        action: Some(0.6),
        recover: Some(0.6),
    ),
)
