// Same self-centered `BasicAura`+`ProtectingWard` shape as aura_of_life.ron
// next door, wider radius per the sheet's own 9m aoe. Sheet's "resist
// sickness and many afflictions" condition-immunity rider dropped -- no
// blanket condition-immunity `BuffEffect` exists; the damage-reduction
// half of "protective ward" is the only part of the flavor this primitive
// can actually deliver.
BasicAura(
    buildup_duration: 0.4,
    cast_duration: 0.3,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: ProtectingWard,
            strength: 0.2,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 9.0,
    energy_cost: 85.0,
    scales_with_combo: false,
    specifier: None,
    meta: (
        school: Some(Abjuration),
        source: Some(Divine),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
