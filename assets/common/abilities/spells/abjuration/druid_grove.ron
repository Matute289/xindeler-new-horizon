// "Wards a stretch of land, turns intruders away and shelters those you
// favor" -- a warded zone, same `SpriteSummon`-as-hazard-ground shape as
// glyph_of_warding.ron/private_sanctum.ron (this file). Sheet's own `aoe`
// field is an unmeasured placeholder per its `notes` field ("area 'C,Q'
// with no measured radius... set to closest cone arm as placeholder");
// this file uses the same radial `summon_distance` shape every other
// SpriteSummon zone-ward in this pass uses rather than inventing a cone
// footprint the variant can't express anyway (no cone-shaped placement
// exists on this variant, only radial `summon_distance`).
SpriteSummon(
    buildup_duration: 0.7,
    cast_duration: 0.6,
    recover_duration: 0.45,
    sprite: EnsnaringVines,
    del_timeout: Some((3600.0, 60.0)),
    summon_distance: (0.0, 9.0),
    sparseness: 0.5,
    angle: 360.0,
    anchor: Summoner,
    move_efficiency: 1.0,
    ori_modifier: 1.0,
    meta: (
        school: Some(Abjuration),
        source: Some(Primordial),
        // level 6 spell -> min_level 36, the level * 6 convention.
        requirements: (min_level: Some(36)),
    ),
)
