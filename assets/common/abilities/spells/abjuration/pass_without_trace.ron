// A hush of drifting shadow spreads from the caster, swallowing footsteps and
// scent so allies caught in the aura move unseen and unheard. The aura stays
// centered on and moves with the caster (BasicAura, not StaticAura) for the
// full concentration duration.
BasicAura(
    buildup_duration: 0.5,
    cast_duration: 0.6,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: PassWithoutTrace,
            strength: 1.0,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 9.0,
    energy_cost: 45.0,
    scales_with_combo: false,
    specifier: None,
    meta: (school: Some(Abjuration), source: Some(Primordial)),
)
