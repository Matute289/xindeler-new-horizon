// Pale moonlight wells up around the caster, draping nearby allies in
// shifting silver dimness that veils their movements and dulls harmful magic
// against them. The aura stays centered on and moves with the caster
// (BasicAura, not StaticAura) for the full concentration duration.
BasicAura(
    buildup_duration: 0.5,
    cast_duration: 0.6,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: Mooncloak,
            strength: 1.5,
            duration: Some(60.0),
            category: Some(Magical),
            misc_data: Some(ResistMagic(0.10)),
        ),
    ],
    aura_duration: Some(60.0),
    range: 6.0,
    energy_cost: 100.0,
    scales_with_combo: false,
    specifier: None,
    meta: (school: Some(Abjuration), source: Some(Primordial)),
)
