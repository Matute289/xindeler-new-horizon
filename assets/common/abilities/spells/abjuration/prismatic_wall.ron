// "Layered plane of light, each band a different destructive energy" --
// same `SpriteSummon`-as-hazard-ground shape as this school's other zone
// wards. Sheet's multi-layer/multi-damage-type/multi-save structure
// collapsed to a single `EnsnaringVines` hazard footprint, same
// simplification glyph_of_warding.ron established -- no per-layer damage
// primitive exists on this variant. `damage_type: Acid` (the sheet's own
// first-listed layer) kept as flavor/i18n only, matching every other
// SpriteSummon zone-ward's damage-type-as-flavor convention in this pass.
// `del_timeout` matches the sheet's own 600s (10 min) duration.
SpriteSummon(
    buildup_duration: 0.8,
    cast_duration: 0.6,
    recover_duration: 0.5,
    sprite: EnsnaringVines,
    del_timeout: Some((600.0, 60.0)),
    summon_distance: (0.0, 18.0),
    sparseness: 0.4,
    angle: 90.0,
    anchor: Summoner,
    move_efficiency: 1.0,
    ori_modifier: 1.0,
    meta: (
        school: Some(Abjuration),
        source: Some(Arcane),
        // level 9 spell -> min_level 54, the level * 6 convention.
        requirements: (min_level: Some(54)),
    ),
)
