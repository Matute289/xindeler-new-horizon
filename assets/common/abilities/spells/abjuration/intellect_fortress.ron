// A psychic ward for a willing mind. D&D's "resistance to psychic damage
// plus advantage on Intelligence/Wisdom/Charisma saves" has no psychic-only
// damage-kind filter and no save-advantage primitive (`ProtectingWard`'s
// reduction is kind-agnostic, per blade_ward.ron's own precedent, and no
// `BuffEffect` grants save advantage anywhere in this engine), so this ships
// as the same flat `ProtectingWard` group ward this file's other
// concentration wards already use, read as "a psychic bulwark" in flavor
// only.
BasicAura(
    buildup_duration: 0.4,
    cast_duration: 0.3,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: ProtectingWard,
            strength: 0.2,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 9.0,
    energy_cost: 40.0,
    scales_with_combo: false,
    specifier: None,
    meta: (school: Some(Abjuration), source: Some(Arcane)),
)
