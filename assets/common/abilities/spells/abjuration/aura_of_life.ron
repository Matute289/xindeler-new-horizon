// Self-centered protective aura, same `BasicAura`+`ProtectingWard` shape
// as shield_of_faith.ron, group-wide (`targets: InGroup`) rather than
// single-touch. Sheet's "prevents dropping to 0 HP / revives downed
// allies" riders dropped -- no death-prevention or revive-on-downed
// primitive exists anywhere in the engine (same gap the deferred
// Necromancy revive spells hit).
BasicAura(
    buildup_duration: 0.4,
    cast_duration: 0.3,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: ProtectingWard,
            strength: 0.2,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 6.0,
    energy_cost: 85.0,
    scales_with_combo: false,
    specifier: None,
    meta: (
        school: Some(Abjuration),
        source: Some(Divine),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
