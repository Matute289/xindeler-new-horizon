// Touch-ally protective ward, same `BasicAura`+`ProtectingWard` shape as
// shield_of_faith.ron. Sheet's "can be moved to a different ally each
// turn" retargeting rider dropped -- no per-turn-retarget mechanic exists
// on any aura primitive; the aura simply covers whoever is in range for
// its duration, same as every other group-aura spell in this pass.
BasicAura(
    buildup_duration: 0.4,
    cast_duration: 0.25,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: ProtectingWard,
            strength: 0.3,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 18.0,
    energy_cost: 105.0,
    scales_with_combo: false,
    specifier: None,
    meta: (
        school: Some(Abjuration),
        source: Some(Arcane),
        // level 6 spell -> min_level 36, the level * 6 convention.
        requirements: (min_level: Some(36)),
    ),
)
