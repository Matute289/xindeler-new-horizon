// Hidden trigger-rune trap, same `SpriteSummon`-as-hazard-ground shape as
// glyph_of_warding.ron. Sheet's "dormant until a chosen condition disturbs
// it, then erupts in a burst of harmful energy" trigger+burst rider
// dropped entirely -- same real, still-open engine gap glyph_of_warding.ron
// documents (no trigger-condition or damage/buff field exists on this
// variant at all). Ships as the same passive hazard-terrain footprint
// every other SpriteSummon zone-ward in this pass uses.
SpriteSummon(
    buildup_duration: 0.6,
    cast_duration: 0.5,
    recover_duration: 0.4,
    sprite: EnsnaringVines,
    del_timeout: Some((3600.0, 60.0)),
    summon_distance: (0.0, 6.0),
    sparseness: 0.5,
    angle: 360.0,
    anchor: Summoner,
    move_efficiency: 1.0,
    ori_modifier: 1.0,
    meta: (
        school: Some(Abjuration),
        source: Some(Arcane),
        // level 7 spell -> min_level 42, the level * 6 convention.
        requirements: (min_level: Some(42)),
    ),
)
