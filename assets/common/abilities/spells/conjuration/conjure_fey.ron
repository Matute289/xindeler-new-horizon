// Real-agent companion summon, same `SummonInfo::Npc` shape established this
// pass (`with_agent`/`incorporeal`/`phantom_illusion` at their
// `#[serde(default)]` values -- `Owned(caster)`, real AI, hittable).
// `body: QuadrupedMedium(Tiger)` stands in for this spell's own summon flavor --
// one fixed already-shipped species, no per-cast form choice exists in the
// data model. No `QuadrupedMedium`-specific summon loadout/skillset preset exists
// (unlike HuskSummon/JiangshiSummon for undead), so both stay `None` --
// deliberate, not an oversight.
// Reviewer correction: half the summoned_amount of
// conjure_woodland_beings.ron (this school's L4 sibling, 2x Tiger) for
// a longer cooldown -- a strict downgrade at a higher level. `scale`
// bumped so the single Tiger is meaningfully bigger/tougher than
// either of the L4 pair, rather than just fewer of the same thing.
BasicSummon(
    buildup_duration: 1.0,
    cast_duration: 0.5,
    recover_duration: 0.4,
    summon_info: Npc(
        summoned_amount: 1,
        summon_distance: (1.0, 3.0),
        body: QuadrupedMedium((species: Tiger, body_type: Male)),
        scale: Some(Scale(1.3)),
        has_health: true,
        use_npc_name: true,
        loadout_config: None,
        skillset_config: None,
        duration: Some((secs: 60, nanos: 0)),
    ),
    meta: (
        school: Some(Conjuration),
        source: Some(Arcane),
        cooldown: Some(45.0),
        // level 6 spell -> min_level 36, the level * 6 convention.
        requirements: (min_level: Some(36)),
    ),
)
