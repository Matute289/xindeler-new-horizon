// Real-agent companion summon, same `SummonInfo::Npc` shape established this
// pass (`with_agent`/`incorporeal`/`phantom_illusion` at their
// `#[serde(default)]` values -- `Owned(caster)`, real AI, hittable).
// `body: BipedLarge(Ogre)` stands in for this spell's own summon flavor --
// one fixed already-shipped species, no per-cast form choice exists in the
// data model. No `BipedLarge`-specific summon loadout/skillset preset exists
// (unlike HuskSummon/JiangshiSummon for undead), so both stay `None` --
// deliberate, not an oversight.
// Reviewer correction: same Ogre reuse issue as planar_ally.ron (L6) --
// this is the L7 tier of the same chain, so it needs a bigger scale
// bump than planar_ally's to keep the level progression meaningful.
BasicSummon(
    buildup_duration: 1.0,
    cast_duration: 0.5,
    recover_duration: 0.4,
    summon_info: Npc(
        summoned_amount: 1,
        summon_distance: (1.0, 3.0),
        body: BipedLarge((species: Ogre, body_type: Male)),
        scale: Some(Scale(1.3)),
        has_health: true,
        use_npc_name: true,
        loadout_config: None,
        skillset_config: None,
        duration: Some((secs: 60, nanos: 0)),
    ),
    meta: (
        school: Some(Conjuration),
        source: Some(Arcane),
        cooldown: Some(55.0),
        // level 7 spell -> min_level 42, the level * 6 convention.
        requirements: (min_level: Some(42)),
    ),
)
