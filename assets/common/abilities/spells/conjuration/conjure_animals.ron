// Real-agent BasicSummon (the `find_familiar.ron` shape), scaled to a pack
// of two instead of one -- "fight at your side" needs real agency, same
// reasoning as `summon_beast.ron` but multiple fighters. `duration` matches
// the spell's own `Concentration(60)`. `body: QuadrupedMedium(Wolf)` stands
// in for "beast-shaped nature spirits" as a pack -- no in-cast
// body-selection UI exists, so one representative pack-beast body covers
// both summons, distinct from `summon_beast.ron`'s solitary `Bear`.
BasicSummon(
    buildup_duration: 1.0,
    cast_duration: 0.5,
    recover_duration: 0.4,
    summon_info: Npc(
        summoned_amount: 2,
        summon_distance: (1.0, 4.0),
        body: QuadrupedMedium((species: Wolf, body_type: Female)),
        scale: None,
        has_health: true,
        use_npc_name: true,
        loadout_config: None,
        skillset_config: None,
        duration: Some((secs: 60, nanos: 0)),
    ),
)
