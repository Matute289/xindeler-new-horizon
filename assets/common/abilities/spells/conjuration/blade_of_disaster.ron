// Real-agent companion summon, same `SummonInfo::Npc` shape established this
// pass (`with_agent`/`incorporeal`/`phantom_illusion` at their
// `#[serde(default)]` values -- `Owned(caster)`, real AI, hittable).
// `body: BipedLarge(Cyclops)` stands in for this spell's own summon flavor --
// one fixed already-shipped species, no per-cast form choice exists in the
// data model. No `BipedLarge`-specific summon loadout/skillset preset exists
// (unlike HuskSummon/JiangshiSummon for undead), so both stay `None` --
// deliberate, not an oversight.
// Reviewer correction: same Cyclops reuse issue as summon_fiend.ron
// (L6) -- this is the L9 tier of the same chain, so it needs a bigger
// scale bump than summon_fiend's to keep the level progression
// meaningful.
BasicSummon(
    buildup_duration: 1.0,
    cast_duration: 0.5,
    recover_duration: 0.4,
    summon_info: Npc(
        summoned_amount: 1,
        summon_distance: (1.0, 3.0),
        body: BipedLarge((species: Cyclops, body_type: Male)),
        scale: Some(Scale(1.35)),
        has_health: true,
        use_npc_name: true,
        loadout_config: None,
        skillset_config: None,
        duration: Some((secs: 60, nanos: 0)),
    ),
    meta: (
        school: Some(Conjuration),
        source: Some(Arcane),
        cooldown: Some(60.0),
        // level 9 spell -> min_level 54, the level * 6 convention.
        requirements: (min_level: Some(54)),
    ),
)
