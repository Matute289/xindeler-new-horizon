// Real fighting companion -- see summon_fey.ron for the shared shape notes.
//
// No dedicated "shadow"/"wraith"/"shade" species exists anywhere in the
// engine (checked every species list in
// common/src/comp/body/{biped_small,biped_large}.rs -- zero shadow-themed
// entries). `Husk` (`BipedSmall`) is reused as the closest available
// gloom/undead-flavored species with its own real combat loadout preset
// (`HuskSummon`, see custom/mindflayer/summonminions.ron), standing in for
// "gloom knit into a corporeal shade".
BasicSummon(
    buildup_duration: 0.9,
    cast_duration: 0.6,
    recover_duration: 0.5,
    summon_info: Npc(
        summoned_amount: 1,
        summon_distance: (2.0, 3.0),
        body: BipedSmall((species: Husk, body_type: Male)),
        scale: None,
        has_health: true,
        use_npc_name: true,
        loadout_config: Some(HuskSummon),
        skillset_config: Some(Rank5),
        duration: Some((secs: 60, nanos: 0)),
    ),
    meta: (school: Some(Conjuration), source: Some(Arcane), cooldown: Some(45.0)),
)
