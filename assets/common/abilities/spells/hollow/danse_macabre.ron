// Real-agent companion summon, same shape as spirit_of_death.ron next door.
// `body: BipedSmall(Husk)` -- "grave-cold power... corpses jerking upright"
// matches Husk's own already-established "raised corpse" flavor
// (hollow/animate_dead.ron, conjuration/summon_shadowspawn.ron), reusing
// its `HuskSummon` preset rather than leaving the thrall unarmed.
BasicSummon(
    buildup_duration: 1.0,
    cast_duration: 0.5,
    recover_duration: 0.4,
    summon_info: Npc(
        summoned_amount: 1,
        summon_distance: (1.0, 3.0),
        body: BipedSmall((species: Husk, body_type: Male)),
        scale: None,
        has_health: true,
        use_npc_name: true,
        loadout_config: Some(HuskSummon),
        skillset_config: Some(Rank5),
        duration: Some((secs: 60, nanos: 0)),
    ),
    meta: (
        school: Some(Necromancy),
        source: Some(Arcane),
        cooldown: Some(50.0),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
