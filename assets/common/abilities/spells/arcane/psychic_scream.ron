// "Multi-target... searing their minds and leaving the unready stunned" --
// same `pooled_debuff` GroundAoe shape as sleep.ron (shared HP-pool
// resolution standing in for the sheet's "up to 10 chosen creatures" cap,
// since no per-cast target-count-selection primitive exists, only spatial
// radius). `BuffKind::Paralyzed` stands in for "stunned" -- the closest
// existing "can't act" primitive, same choice psychic_lance.ron made for
// its own incapacitate rider. Sheet's raw damage half is dropped:
// `pooled_debuff` fully replaces the strike's normal damage path, and the
// stun is this spell's whole point (unlike synaptic_static.ron next door,
// where the burst damage was kept and its secondary debuff dropped
// instead).
GroundAoe(
    energy_cost: 220.0,
    buildup_duration: 0.7,
    delay: 0.5,
    recover_duration: 0.5,
    max_range: 27.0,
    radius: 9.0,
    min_falloff: 0.4,
    damage: 0.0,
    poise: 0.0,
    knockback: (strength: 0.0, direction: Away),
    dodgeable: No,
    reagent: None,
    rooted_cast: false,
    pooled_debuff: Some((
        pool: 90.0,
        buff: (
            kind: Paralyzed,
            dur_secs: 6,
            strength: Value(1.0),
            chance: 1.0,
        ),
    )),
    meta: (
        school: Some(Enchantment),
        source: Some(Arcane),
        // level 9 spell -> min_level 54, the level * 6 convention.
        requirements: (min_level: Some(54)),
    ),
)
