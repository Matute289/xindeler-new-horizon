// Ally buff: grants temporary vitality and steadier resolve against fear to
// allies caught in the caster's aura. "Advantage vs fear" narrows to the
// existing Fearless tag (full immunity to Terrified -- no partial-advantage
// primitive exists), the same rider-narrowing idiom N76-I's
// chill_touch/spare_the_dying used. "Temporary vitality" reuses the
// Shielded absorb-pool buff, the same primitive false_life.ron used for
// temp HP, strength scaled down since this is a group aura rather than a
// dedicated single-target temp-HP spell.
BasicAura(
    buildup_duration: 0.5,
    cast_duration: 0.6,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: Shielded,
            strength: 12.0,
            duration: Some(60.0),
            category: Some(Magical),
        ),
        (
            kind: Fearless,
            strength: 0.0,
            duration: Some(60.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(60.0),
    range: 18.0,
    energy_cost: 90.0,
    scales_with_combo: false,
    specifier: None,
    meta: (
        school: Some(Enchantment),
        source: Some(Arcane),
        // level 3 spell -> min_level 18, the `level * 6` convention (see
        // sleep.ron).
        requirements: (min_level: Some(18)),
    ),
)
