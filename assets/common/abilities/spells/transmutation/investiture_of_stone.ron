// Same shape as investiture_of_flame.ron -- `ProtectingWard` for the
// skin-hardening half, the earth-glide movement rider dropped, no
// terrain-phasing primitive exists.
SelfBuff(
    buildup_duration: 0.4,
    cast_duration: 0.2,
    recover_duration: 0.3,
    buffs: [
        BuffDesc(kind: ProtectingWard, data: BuffData(strength: 0.4, duration: Some(60.0))),
    ],
    energy_cost: 115.0,
    meta: (
        school: Some(Transmutation),
        source: Some(Arcane),
        // level 6 spell -> min_level 36, the level * 6 convention.
        requirements: (min_level: Some(36)),
    ),
)
