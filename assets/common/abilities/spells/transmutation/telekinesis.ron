    energy_cost: 15,
    energy_drain: 5.0,
    buildup_duration: 0.3,
    charge_duration: 2.5,
    place_threshold: 0.5,
    recover_duration: 0.3,
    range: 18.0,          // ~60 ft: D&D's telekinesis range
