    projectile: (
        kind: Simple,
        attack: Some((
            damage: 25.0,
            poise: Some(20.0),
            friendly_fire: true,
            damage_kind: Crushing,
        )),
        pierce_entities: true,
    ),
    move_speed: 0.7,
)
