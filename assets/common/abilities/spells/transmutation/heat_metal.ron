// `BuffKind::Burning` ("Does damage to a creature over time") is the nearest
// existing primitive for "channel searing heat into metal until it glows
// red-hot, scorching whoever wears or wields it" -- applied directly as the
// projectile's own on-hit debuff, same shape as `hollow/cause_fear.ron`'s
// `Terrified` rider. The sheet's "target may drop what they carry" rider
// (forcing an item-drop choice each round) has no primitive -- no
// `BuffEffect` forces an inventory/hand-item change -- and is dropped.
BasicRanged(
    energy_cost: 25,
    buildup_duration: 0.35,
    recover_duration: 0.3,
    projectile: (
        kind: Simple,
        attack: Some((
            damage: 15,
            buff: Some((
                kind: Burning,
                dur_secs: 10,
                strength: Value(3.0),
                chance: 1.0,
            )),
            damage_kind: Fire,
        )),
    ),
    projectile_body: Object(BoltFire),
    projectile_speed: 60.0,
    num_projectiles: Value(1),
    meta: (
        school: Some(Transmutation),
        source: Some(Arcane),
        // level 2 spell -> min_level 12, same `level * 6` convention.
        requirements: (min_level: Some(12)),
    ),
)
