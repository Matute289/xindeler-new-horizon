// D&D's Earthbind zeroes a flying creature's flying speed specifically; this
// engine has no separate flying-speed stat (checked `common/src/comp/
// buff.rs`'s full `BuffEffect` list -- only a single `MovementSpeed`
// multiplier exists, no flight-specific channel). `BuffKind::Rooted`
// ("Reduces movement speed to 0") is the nearest available primitive --
// grounds the target's movement outright rather than only their flight,
// broader than the sheet's own effect. No damage, matching the sheet.
BasicRanged(
    energy_cost: 30,
    buildup_duration: 0.35,
    recover_duration: 0.3,
    projectile: (
        kind: Simple,
        attack: Some((
            damage: 0,
            buff: Some((
                kind: Rooted,
                dur_secs: 10.0,
                strength: Value(1.5),
                chance: 1.0,
            )),
            damage_kind: Bludgeoning,
        )),
    ),
    projectile_body: Object(BoltFire),
    projectile_speed: 55.0,
    num_projectiles: Value(1),
    meta: (
        school: Some(Transmutation),
        source: Some(Arcane),
        // level 2 spell -> min_level 12, same `level * 6` convention.
        requirements: (min_level: Some(12)),
    ),
)
