// Same `Transform`-variant deviation as guardian_of_nature.ron -- see that
// file's header for the full precedent trail (`Polymorphed`+`BodyChange`
// instead of the literal, persistence-breaking `Transform` variant).
// Sheet describes this cast on an unwilling enemy; `SelfBuff` always lands
// on the caster, so this narrows to a self-cast shapeshift, same class of
// narrowing every other ally/enemy-targeted `SelfBuff` in this compendium
// already makes. `QuadrupedSmall(Sheep)` stands in for "weaker beast form."
SelfBuff(
    buildup_duration: 0.5,
    cast_duration: 0.3,
    recover_duration: 0.3,
    buffs: [
        BuffDesc(
            kind: Polymorphed,
            data: BuffData(
                strength: 0.0,
                duration: Some(60.0),
                misc_data: Some(Body(QuadrupedSmall((species: Sheep, body_type: Male)))),
            ),
        ),
    ],
    energy_cost: 80,
    enforced_limit: true,
    meta: (
        school: Some(Transmutation),
        source: Some(Arcane),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
