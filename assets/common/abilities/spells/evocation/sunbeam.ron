// Sustained beam, same shape as immolation.ron scaled to circle 6.
// `specifier: PhoenixLaser` is the closest existing bright/radiant beam
// frontend. Sheet's dazzle-on-fail rider dropped, no blind/dazzle
// on-tick trigger exists for BasicBeam.
BasicBeam(
    buildup_duration: 0.4,
    recover_duration: 0.35,
    beam_duration: 60,
    damage: 16.0,
    tick_rate: 3.0,
    range: 18.0,
    max_angle: 5.0,
    damage_effect: None,
    energy_regen: 0,
    energy_drain: 26,
    move_efficiency: 0.3,
    ori_rate: 0.3,
    specifier: PhoenixLaser,
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        // level 6 spell -> min_level 36, the level * 6 convention.
        requirements: (min_level: Some(36)),
    ),
)
