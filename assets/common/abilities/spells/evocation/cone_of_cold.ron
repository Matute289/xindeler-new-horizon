// Cone-shaped burst damage, same `Shockwave` shape as fear.ron scaled to
// circle 5 (real damage instead of a buff this time -- damage is the
// spell's own stated centerpiece).
Shockwave(
    energy_cost: 130.0,
    buildup_duration: 0.6,
    swing_duration: 0.35,
    recover_duration: 0.45,
    damage: 60.0,
    poise_damage: 15,
    knockback: (strength: 0.0, direction: Away),
    shockwave_angle: 60.0,
    shockwave_vertical_angle: 45.0,
    shockwave_speed: 25.0,
    shockwave_duration: 0.4,
    dodgeable: Jump,
    move_efficiency: 0.1,
    damage_kind: Cold,
    specifier: Ground,
    damage_effect: None,
    ori_rate: 1.0,
    timing: PostBuildup,
    emit_outcome: true,
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
