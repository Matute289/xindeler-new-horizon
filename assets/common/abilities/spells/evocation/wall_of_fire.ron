// Wall-shaped lingering hazard, same `SpriteSummon`+`EnsnaringVines`
// shape as abjuration/prismatic_wall.ron. Sheet's fire-damage-on-flare/
// push-through rider dropped, same real engine gap glyph_of_warding.ron
// documents (no damage/buff/trigger field exists on this variant).
SpriteSummon(
    buildup_duration: 0.7,
    cast_duration: 0.5,
    recover_duration: 0.45,
    sprite: EnsnaringVines,
    del_timeout: Some((60.0, 30.0)),
    summon_distance: (0.0, 9.0),
    sparseness: 0.4,
    angle: 90.0,
    anchor: Summoner,
    move_efficiency: 1.0,
    ori_modifier: 1.0,
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
