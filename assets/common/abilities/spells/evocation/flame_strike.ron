// Reviewer correction: originally authored as Explosion, which always
// detonates centered on the caster (no target-point field exists) --
// contradicted this spell own longer cast range. Converted to GroundAoe,
// the real detonate-at-a-chosen-point primitive.
// Same straight-damage Explosion shape as destructive_wave.ron, same
// circle.
GroundAoe(
    energy_cost: 145.0,
    buildup_duration: 0.65,
    delay: 0.4,
    max_range: 18.0,
    recover_duration: 0.5,
    damage: 62,
    poise: 15,
    knockback: (direction: Away, strength: 0.0),
    radius: 3,
    min_falloff: 0.35,
    dodgeable: Roll,
    rooted_cast: false,
    reagent: Some(Red),
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
