// Group heal, same `BasicAura`+`Regeneration` shape as heal.ron, group-
// targeted instead of single-ally.
BasicAura(
    buildup_duration: 0.5,
    cast_duration: 0.5,
    recover_duration: 0.35,
    targets: InGroup,
    auras: [
        (
            kind: Regeneration,
            strength: 16.0,
            duration: Some(3.0),
            category: Some(Magical),
        ),
    ],
    aura_duration: Some(3.0),
    range: 6.0,
    energy_cost: 145.0,
    scales_with_combo: false,
    specifier: None,
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        cooldown: Some(20.0),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
