    energy_cost: 100.0,
    buildup_duration: 0.6,
    delay: 0.4,
    recover_duration: 0.45,
    max_range: 46.0,
    radius: 6.0,
    min_falloff: 0.4,
    damage: 44,
    poise: 10,
    knockback: (strength: 5.0, direction: Away),
    dodgeable: Roll,
    reagent: None,
    rooted_cast: false,
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
