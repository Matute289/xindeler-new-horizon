// Straight burst-damage GroundAoe, same shape as dark_star.ron, scaled to
// the fireball.ron->dark_star.ron circle curve. Sheet's cumulative-
// exhaustion/glow-debuff rider dropped, no such stacking-debuff primitive
// exists.
GroundAoe(
    energy_cost: 100.0,
    buildup_duration: 0.6,
    delay: 0.4,
    recover_duration: 0.45,
    max_range: 37.0,
    radius: 6.0,
    min_falloff: 0.4,
    damage: 44,
    poise: 10,
    knockback: (strength: 0.0, direction: Away),
    dodgeable: Roll,
    reagent: None,
    rooted_cast: false,
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
