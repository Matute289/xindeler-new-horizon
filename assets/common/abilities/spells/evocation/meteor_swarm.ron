// Straight-damage Explosion, the wave's circle-9 capstone nuke, matching
// axiomancy/dark_star.ron's own L9 damage/energy anchor. Sheet's "four
// separate distant impact points" multi-origin burst dropped -- no
// multi-origin/multi-target-point Explosion primitive exists; ships as one
// self-centered burst at the full capstone damage instead.
Explosion(
    energy_cost: 225.0,
    buildup_duration: 0.9,
    action_duration: 0.35,
    recover_duration: 0.6,
    damage: 130,
    poise: 30,
    knockback: (direction: Away, strength: 12.0),
    radius: 6,
    min_falloff: 0.3,
    dodgeable: Roll,
    destroy_terrain: None,
    eye_height: false,
    reagent: Some(Red),
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        cooldown: Some(60.0),
        // level 9 spell -> min_level 54, the level * 6 convention.
        requirements: (min_level: Some(54)),
    ),
)
