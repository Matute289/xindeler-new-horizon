// Straight-damage Explosion, scaled to circle 7. Sheet's grow-over-time
// delayed-trigger rider dropped, no held-charge/delayed-detonation
// primitive exists -- ships as an immediate burst at the tuned circle-7
// damage instead.
Explosion(
    energy_cost: 185.0,
    buildup_duration: 0.8,
    action_duration: 0.3,
    recover_duration: 0.55,
    damage: 100,
    poise: 20,
    knockback: (direction: Away, strength: 8.0),
    radius: 6,
    min_falloff: 0.3,
    dodgeable: Roll,
    destroy_terrain: None,
    eye_height: false,
    reagent: Some(Red),
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        cooldown: Some(45.0),
        // level 7 spell -> min_level 42, the level * 6 convention.
        requirements: (min_level: Some(42)),
    ),
)
