// Self-centered straight-damage Explosion, scaled to circle 5. Sheet's
// knock-prone rider dropped, kept as flat knockback instead.
Explosion(
    energy_cost: 145.0,
    buildup_duration: 0.65,
    action_duration: 0.3,
    recover_duration: 0.5,
    damage: 62,
    poise: 20,
    knockback: (direction: Away, strength: 10.0),
    radius: 9,
    min_falloff: 0.35,
    dodgeable: Roll,
    destroy_terrain: None,
    eye_height: false,
    reagent: Some(White),
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
