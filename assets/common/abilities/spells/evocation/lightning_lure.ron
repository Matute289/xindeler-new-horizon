// The "yank the target closer" rider IS modeled, via the same
// Knockback(direction: Towards) primitive MeleeConstructorKind::Hook and
// GroundAoe pulls already use internally (common/src/comp/melee.rs,
// assets/common/abilities/spells/axiomancy/dark_star.ron) -- but attached
// through the generic `attack_effect` field instead of reusing Hook itself,
// because Hook hardcodes DamageKind::Piercing plus an unrelated Bleeding
// proc that doesn't fit a lightning spell. Stab is used for the base
// strike instead (see booming_blade.ron for why no MeleeConstructorKind
// offers a real Lightning damage_kind -- the true in-engine damage type
// here is Piercing, flavor-only mismatch).
BasicMelee(
    energy_cost: 0,
    buildup_duration: 0.4,
    swing_duration: 0.1,
    hit_timing: 0.5,
    recover_duration: 0.3,
    melee_constructor: (
        kind: Stab(damage: 12, poise: 0, knockback: 0, energy_regen: 0),
        range: 5.0,
        angle: 20.0,
        attack_effect: Some((
            Knockback((direction: Towards, strength: 3.0)),
            AnyDamage,
        )),
    ),
    meta: (school: Some(Evocation), source: Some(Arcane)),
)
