    damage: 100.0,
    poise_damage: 20,
    knockback: (strength: 0.0, direction: Away),
    shockwave_angle: 90.0,
    shockwave_vertical_angle: 45.0,
    shockwave_speed: 25.0,
    shockwave_duration: 0.45,
    dodgeable: Jump,
