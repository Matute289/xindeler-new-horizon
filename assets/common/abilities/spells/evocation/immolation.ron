// Sustained single-target damage beam, same `BasicBeam` shape as
// witch_bolt.ron scaled to circle 5. `specifier: Flamethrower` is the
// closest existing fire-flavored beam frontend.
BasicBeam(
    buildup_duration: 0.4,
    recover_duration: 0.35,
    beam_duration: 60,
    damage: 12.0,
    tick_rate: 3.0,
    range: 27.0,
    max_angle: 5.0,
    damage_effect: None,
    energy_regen: 0,
    energy_drain: 22,
    move_efficiency: 0.3,
    ori_rate: 0.3,
    specifier: Flamethrower,
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        // level 5 spell -> min_level 30, the level * 6 convention.
        requirements: (min_level: Some(30)),
    ),
)
