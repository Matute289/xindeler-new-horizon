// Same straight-damage GroundAoe shape as sickening_radiance.ron, same
// circle. Sheet's cylinder-vs-sphere shape approximated to a sphere radius,
// same simplification every other cylinder-aoe spell in this pass makes.
GroundAoe(
    energy_cost: 100.0,
    buildup_duration: 0.6,
    delay: 0.4,
    recover_duration: 0.45,
    max_range: 18.0,
    radius: 6.0,
    min_falloff: 0.4,
    damage: 44,
    poise: 10,
    knockback: (strength: 0.0, direction: Away),
    dodgeable: Roll,
    reagent: None,
    rooted_cast: false,
    meta: (
        school: Some(Evocation),
        source: Some(Divine),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
