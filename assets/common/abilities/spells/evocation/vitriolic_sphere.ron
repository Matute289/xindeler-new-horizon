// Reviewer correction: originally authored as Explosion, which always
// detonates centered on the caster (no target-point field exists) --
// contradicted this spell own longer cast range. Converted to GroundAoe,
// the real detonate-at-a-chosen-point primitive.
// Same straight-damage Explosion shape as ice_storm.ron, same circle.
GroundAoe(
    energy_cost: 105.0,
    buildup_duration: 0.7,
    delay: 0.4,
    max_range: 46.0,
    recover_duration: 0.5,
    damage: 55,
    poise: 15,
    knockback: (direction: Away, strength: 0.0),
    radius: 6,
    min_falloff: 0.35,
    dodgeable: Roll,
    rooted_cast: false,
    reagent: Some(Green),
    meta: (
        school: Some(Evocation),
        source: Some(Arcane),
        // level 4 spell -> min_level 24, the level * 6 convention.
        requirements: (min_level: Some(24)),
    ),
)
