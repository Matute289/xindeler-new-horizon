// Detect Poison and Disease: `BuffKind::Detecting` applied to
// `SenseKind::Affliction`, which reveals any target currently carrying one of
// the engine's ailment-flavoured buffs (`AFFLICTION_BUFFS` in
// `server/src/sys/detection.rs`: `Poisoned`, `Cursed`, `Burning`). The engine
// has no dedicated "disease" buff family yet, so this reveals the ailment
// buffs that do exist rather than a literal poison/disease split -- a
// presence-only glow, not the D&D original's "discern the exact nature of
// each one".
//
// `SenseMode::Snapshot`: membership is frozen at cast and held for the
// buff's `Concentration(60)` duration.
SelfBuff(
    buildup_duration: 0.5,
    cast_duration: 0.3,
    recover_duration: 0.2,
    buffs: [
        BuffDesc(
            kind: Detecting,
            data: BuffData(
                strength: 0.0,
                duration: Some(60.0),
                // Sheet aoe: 30 ft radius -> Sphere r9.
                misc_data: Some(Sense(Affliction, 9.0, Snapshot)),
            ),
        ),
    ],
    energy_cost: 15,
    enforced_limit: false,
    meta: (
        school: Some(Divination),
        source: Some(Divine),
        // level 1 spell -> min_level 6, same `level * 6` convention
        // see_invisibility.ron/true_seeing.ron derive from every other
        // shipped spell that sets this field.
        requirements: (min_level: Some(6)),
    ),
)
