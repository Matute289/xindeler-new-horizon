// The sheet's random-per-round effect table (a different mischievous effect
// each round -- trip, dazzle, confound) has no per-cast-random primitive in
// GroundAoe (a single fixed buff is applied per cast; see
// CharacterAbility::GroundAoe's pooled_debuff doc comment). Narrows to one
// fixed effect, Blinded (the "dazzled" reading), applied to everyone caught
// in the cube via the same shared-HP-pool resolution sleep.ron's own
// pooled_debuff already uses. The "trip" (forced-prone/knockdown) half of
// the table is dropped -- no fitting BuffKind exists for that status.
GroundAoe(
    energy_cost: 60.0,
    buildup_duration: 0.6,
    delay: 0.5,
    recover_duration: 0.4,
    max_range: 18.0,
    radius: 3.0,
    min_falloff: 0.4,
    damage: 0.0,
    poise: 0.0,
    knockback: (strength: 0.0, direction: Away),
    dodgeable: No,
    reagent: None,
    rooted_cast: false,
    pooled_debuff: Some((
        pool: 40.0,
        buff: (
            kind: Blinded,
            dur_secs: 10,
            strength: Value(0.5),
            chance: 1.0,
        ),
    )),
    meta: (
        school: Some(Illusion),
        source: Some(Arcane),
        // level 2 spell -> min_level 12, the `level * 6` convention (see
        // sleep.ron).
        requirements: (min_level: Some(12)),
    ),
)
