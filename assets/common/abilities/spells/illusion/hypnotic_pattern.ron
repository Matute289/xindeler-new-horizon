// Same "shared HP-pool incapacitation" shape as sleep.ron (Asleep via
// pooled_debuff), scaled up for this spell's higher circle and larger
// radius. The sheet's Concentration(60) narrows to Instant, matching
// sleep.ron's own precedent: pooled_debuff GroundAoe effects have no
// concentration-linked duration mechanism -- the buff runs its own
// independent dur_secs timer regardless of whether the caster keeps
// concentrating.
GroundAoe(
    energy_cost: 75.0,
    buildup_duration: 0.6,
    delay: 0.5,
    recover_duration: 0.4,
    max_range: 37.0,
    radius: 6.0,
    min_falloff: 0.4,
    damage: 0.0,
    poise: 0.0,
    knockback: (strength: 0.0, direction: Away),
    dodgeable: No,
    reagent: None,
    rooted_cast: false,
    pooled_debuff: Some((
        pool: 50.0,
        buff: (
            kind: Asleep,
            dur_secs: 60,
            strength: Value(1.0),
            chance: 1.0,
        ),
    )),
    meta: (
        school: Some(Illusion),
        source: Some(Arcane),
        // level 3 spell -> min_level 18, the `level * 6` convention (see
        // sleep.ron). Real gap without this: the mastery/transcription
        // learned-spellbook path (common/src/comp/spell_mastery.rs,
        // transcription.rs) clears the class-level SpellGate entirely and
        // relies solely on this field as the floor.
        requirements: (min_level: Some(18)),
    ),
)
