// Per-class castable magic sources ("cores", hard gate): a spell whose
// ability declares a `source` outside this set is refused at activation
// outright, regardless of what the caster is holding. Mirrors
// class_attributes.ron's manifest shape and hot-reload behavior.
//
// A class missing from this map resolves to `ClassMagicSources::All`
// (permissive fail-open), matching class_proficiencies.ron's own rule.
// `Only([])` (an explicitly empty list) is DIFFERENT from a missing key: it
// means "this class can never cast any source-bearing ability", and is
// load-bearing, not an oversight — do not delete these rows to "clean up".
{
    Adventurer: All, // legacy permissive
    Warrior: Only([]), // never casts, full stop
    Barbarian: Only([]),
    Rogue: Only([]),
    Monk: Only([Ki]),
    // TEMPORARY stand-in: Mage can cast all 5 cores, gated only by the
    // existing skill-tree unlocks, until the real identify/transcribe
    // system replaces this with Only([Arcane]).
    Mage: All,
    Sorcerer: Only([Arcane]), // a small fixed set of Primordial spells is intended to arrive as class innates, not via this mask
    Warlock: Only([Arcane]),
    Bard: Only([Arcane]),
    Artificer: Only([Arcane]),
    Cleric: Only([Divine]),
    Paladin: Only([Divine]),
    Druid: Only([Primordial]),
    Ranger: Only([Primordial]),
    // No core of its own; its Hemomancy spells are intended to arrive as
    // class innates, exempted from this mask by a cast-gate exemption that
    // will be added when that innate-spell delivery mechanism ships.
    BloodSlayer: Only([]),
}
