# Legacy Staff kit — cataloged only for the per-class cast gate, not shown in
# the Diary Spells tab (see SpellDef::pool_eligible). Names/descriptions still
# need to exist so content passes the compendium's name-string coverage test.
spell-legacy-firebomb = Firebomb
spell-legacy-firebomb-desc = Hurls an explosive bolt of flame that ignites the ground and anything caught in the blast.
spell-legacy-flamethrower = Flamethrower
spell-legacy-flamethrower-desc = Channels a continuous jet of flame in a cone, scorching anything in its path.
spell-legacy-fireshockwave = Fire Shockwave
spell-legacy-fireshockwave-desc = Erupts in a searing wave of fire that radiates outward in every direction.
spell-legacy-napalm_strike = Napalm Strike
spell-legacy-napalm_strike-desc = Launches a volley of napalm that creates an area of effect damage zone.
spell-legacy-flame_cloak = Flame Cloak
spell-legacy-flame_cloak-desc = Wreathes you in flame, burning anyone who strays too close.
spell-legacy-fire_dash = Fire Dash
spell-legacy-fire_dash-desc = Surges forward wreathed in fire, searing anything caught in your path.
spell-legacy-fire_breath = Fire Breath
spell-legacy-fire_breath-desc = Exhales a torrent of fire in a ring around you, engulfing anything nearby.
spell-legacy-pyroclasm = Pyroclasm
spell-legacy-pyroclasm-desc = Unleashes a rapid volley of homing fire bolts.
